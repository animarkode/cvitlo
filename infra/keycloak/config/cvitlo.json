{
  "realm": "cvitlo",
  "displayName": "Cvitlo",
  "enabled": true,
  "loginTheme": "cvitlo",
  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,

  "passwordPolicy": "length(8) and maxLength(128) and notEmail(undefined) and notUsername(undefined)",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 604800,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,

  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,

  "webAuthnPolicyRpEntityName": "Cvitlo",
  "webAuthnPolicyPasswordlessRpEntityName": "Cvitlo",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",

  "smtpServer": {
    "host": "$(env:KC_SMTP_HOST)",
    "port": "$(env:KC_SMTP_PORT)",
    "from": "$(env:KC_SMTP_FROM)",
    "fromDisplayName": "Cvitlo",
    "auth": "$(env:KC_SMTP_AUTH:-false)",
    "user": "$(env:KC_SMTP_USER:-)",
    "password": "$(env:KC_SMTP_PASSWORD:-)",
    "ssl": "$(env:KC_SMTP_SSL:-false)",
    "starttls": "$(env:KC_SMTP_STARTTLS:-false)"
  },

  "roles": {
    "realm": [
      { "name": "regular", "description": "Default plan" },
      { "name": "premium", "description": "Paid plan" },
      {
        "name": "default-roles-cvitlo",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "regular"],
          "client": { "account": ["view-profile", "manage-account"] }
        }
      }
    ]
  },

  "users": [
    {
      "username": "service-account-cvitlo-admin",
      "enabled": true,
      "serviceAccountClientId": "cvitlo-admin",
      "clientRoles": { "realm-management": ["manage-users"] }
    }
  ],

  "clients": [
    {
      "clientId": "cvitlo-api",
      "name": "Cvitlo",
      "description": "The Cvitlo API, which signs web users in as a backend-for-frontend.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:CVITLO_API_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "rootUrl": "$(env:CVITLO_APP_URL)",
      "baseUrl": "$(env:CVITLO_APP_URL)",
      "redirectUris": ["$(env:CVITLO_APP_URL)/api/v1/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$(env:CVITLO_APP_URL)",
        "backchannel.logout.url": "$(env:CVITLO_BACKCHANNEL_LOGOUT_URL)",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "use.refresh.tokens": "true",
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "cvitlo-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cvitlo-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "cvitlo-admin",
      "name": "Cvitlo admin",
      "description": "Service account the API uses to delete a user's own account. It can only manage users and has no sign-in flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:CVITLO_ADMIN_CLIENT_SECRET)",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "standard.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    },
    {
      "clientId": "account",
      "enabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    { "clientId": "account-console", "enabled": false },
    { "clientId": "security-admin-console", "enabled": false },
    { "clientId": "admin-cli", "directAccessGrantsEnabled": false }
  ],

  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": $(env:GOOGLE_ENABLED:-false),
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "cvitlo first broker login",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID:-unset)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET:-unset)",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "filteredByClaim": "true",
        "claimFilterName": "email_verified",
        "claimFilterValue": "true",
        "prompt": "select_account",
        "guiOrder": "1"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": $(env:GITHUB_ENABLED:-false),
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "cvitlo first broker login",
      "config": {
        "clientId": "$(env:GITHUB_CLIENT_ID:-unset)",
        "clientSecret": "$(env:GITHUB_CLIENT_SECRET:-unset)",
        "defaultScope": "user:email",
        "syncMode": "IMPORT",
        "prompt": "select_account",
        "guiOrder": "2"
      }
    }
  ],

  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 70,
      "config": {
        "max_auth_age": "300"
      }
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "idp_link",
      "name": "Linking Identity Provider",
      "providerId": "idp_link",
      "enabled": true,
      "defaultAction": false,
      "priority": 55,
      "config": { "max_auth_age": "300" }
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": false,
      "defaultAction": false,
      "priority": 60,
      "config": { "max_auth_age": "300" }
    }
  ],

  "authenticatorConfig": [
    {
      "alias": "cvitlo review profile config",
      "config": { "update.profile.on.first.login": "missing" }
    },
    {
      "alias": "cvitlo create unique user config",
      "config": { "require.password.update.after.registration": "false" }
    },
    {
      "alias": "cvitlo reauthentication conditional credential",
      "config": { "credentials": "webauthn-passwordless" }
    }
  ],

  "authenticationFlows": [
    {
      "alias": "cvitlo first broker login",
      "description": "First sign-in through Google or GitHub: create the user when the e-mail is new; otherwise link only after the person re-authenticates to the existing account.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "authenticatorConfig": "cvitlo review profile config",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "cvitlo user creation or linking",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "cvitlo user creation or linking",
      "description": "Create the user when the e-mail is unique, otherwise handle the existing account.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorConfig": "cvitlo create unique user config",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "cvitlo handle existing account",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "cvitlo handle existing account",
      "description": "An account with this e-mail exists: confirm the link, then prove ownership by signing in to it.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-confirm-link",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "cvitlo verify existing account by re-authentication",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "cvitlo verify existing account by re-authentication",
      "description": "Sign in to the existing account with its password or another linked provider, plus 2FA when set up. No e-mail-link alternative.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "cvitlo reauthentication conditional 2fa",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "cvitlo reauthentication conditional 2fa",
      "description": "Ask for the second factor the user has set up, unless a passkey was used.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "conditional-credential",
          "authenticatorConfig": "cvitlo reauthentication conditional credential",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    }
  ],

  "firstBrokerLoginFlow": "cvitlo first broker login"
}
